<Window x:Class="MusicOrganiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MusicOrganiser.Converters"
        xmlns:controls="clr-namespace:MusicOrganiser.Controls"
        mc:Ignorable="d"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="logo.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NowPlayingConverter x:Key="NowPlayingConverter"/>
        <converters:NowPlayingBoolConverter x:Key="NowPlayingBoolConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:TitleConverter x:Key="TitleConverter"/>
        <converters:PlayingFolderFontWeightConverter x:Key="PlayingFolderFontWeightConverter"/>

        <!-- Flat, circular transport buttons. Background is TemplateBound so the active-state
             DataTriggers (shuffle/repeat) still colour the button. -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#33373E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="21"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9EEF4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DCE6F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary play/pause button: larger accent-filled circle (matches the mobile app). -->
        <Style x:Key="PlayerPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F8FE0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="26"
                                Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B82CC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#256FB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Title>
        <MultiBinding Converter="{StaticResource TitleConverter}">
            <Binding Path="CurrentFolderPath"/>
            <Binding Path="NowPlaying"/>
        </MultiBinding>
    </Window.Title>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Folders + Playlists tabs -->
        <TabControl Grid.Column="0">
        <TabItem Header="Folders">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TreeView x:Name="FolderTreeView" Grid.Row="0"
                      ItemsSource="{Binding FolderTree.RootNodes}"
                      SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                      MouseMove="FolderTreeView_MouseMove"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.Resources>
                    <!-- Compact expander arrow for the retemplated TreeViewItem below. -->
                    <Style x:Key="TreeExpanderToggle" TargetType="ToggleButton">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Height" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="8" Height="14">
                                        <Path x:Name="Arrow" Fill="#606060" Data="M 0 0 L 4 4 L 0 8 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="#303030"/>
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                        <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_MouseRightButtonDown"/>
                        <!-- Drop target for dragged grid files / other folders (see MainWindow.xaml.cs). -->
                        <Setter Property="AllowDrop" Value="True"/>
                        <EventSetter Event="DragOver" Handler="FolderItem_DragOver"/>
                        <EventSetter Event="Drop" Handler="FolderItem_Drop"/>
                        <!-- Retemplated to shrink the per-level indent (expander column 12px vs the
                             ~19px default), so deep folder chains don't march off to the right. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press"
                                                      Style="{StaticResource TreeExpanderToggle}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Border x:Name="Bd" Grid.Column="1"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CCE8FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel x:Name="FolderRow" Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="{Binding Name}" Padding="2" VerticalAlignment="Center">
                                <TextBlock.FontWeight>
                                    <MultiBinding Converter="{StaticResource PlayingFolderFontWeightConverter}">
                                        <Binding Path="FullPath"/>
                                        <Binding Path="DataContext.NowPlaying.FullPath" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </TextBlock.FontWeight>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Zero-width Canvas: the hover-reveal stars/tags render as an overlay
                                 past the row's measured width, so the tree's horizontal scroll extent
                                 never changes on hover (no viewport jump). Canvas doesn't clip. -->
                            <Canvas Width="0">
                                <Border Background="Transparent"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:StarRating Rating="{Binding Rating, Mode=TwoWay}"
                                                             EditMode="{Binding IsMouseOver, ElementName=FolderRow}"
                                                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Tags}" VerticalAlignment="Center"
                                                   FontSize="10" Foreground="#777777" Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=FolderRow}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Width="90" FontSize="10" Padding="2,0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Margin="6,0,0,0" Background="Transparent" BorderBrush="#DDDDDD"
                                                 ToolTip="Comma-separated tags">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=FolderRow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu x:Name="FolderContextMenu" Opened="FolderContextMenu_Opened">
                        <MenuItem Header="Play folder" Click="FolderPlay_Click"/>
                        <Separator/>
                        <MenuItem Header="New subfolder" Click="FolderNewSubfolder_Click"/>
                        <MenuItem Header="Refresh" Click="FolderRefresh_Click"/>
                        <MenuItem Header="Tag..." Click="FolderTag_Click"/>
                        <MenuItem Header="Bulk tag subfolders..." Click="BulkTag_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy folder name" Tag="name" Click="FolderCopyText_Click"/>
                        <MenuItem Header="Copy path" Tag="dir" Click="FolderCopyText_Click"/>
                        <MenuItem Header="Copy full path" Tag="full" Click="FolderCopyText_Click"/>
                        <Separator/>
                        <MenuItem x:Name="FolderCopyToMenu" Header="Copy To"/>
                        <MenuItem x:Name="FolderMoveToMenu" Header="Move To"/>
                        <Separator/>
                        <MenuItem x:Name="FolderAddToPlaylistMenu" Header="Add Folder to Playlist"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="FolderDelete_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>

            <!-- Filter and Sort Panel -->
            <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="^" Width="22" Height="22" Margin="0,0,4,0"
                                Padding="0" FontWeight="Bold" VerticalAlignment="Center"
                                ToolTip="Up a level" Click="UpLevel_Click"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="FilterBox"
                                     Text="{Binding FolderTree.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter folders"
                                     Padding="0,0,20,0"/>
                            <!-- One-click clear; hidden while the filter is empty -->
                            <Button Content="&#x2715;" Click="ClearFilter_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="18" Height="18" Margin="0,0,3,0" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#888888" FontSize="11" Cursor="Hand"
                                    ToolTip="Clear filter">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FolderTree.FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                    <ComboBox Grid.Row="1" Margin="0,0,0,5"
                              ItemsSource="{Binding FolderTree.SortOptions}"
                              SelectedItem="{Binding FolderTree.SelectedSortOption}"
                              ToolTip="Sort folders by"/>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TagsFilterToggle" Content="Tags"
                                          Padding="6,3"
                                          ToolTip="Filter folders by tag"/>
                            <ToggleButton x:Name="FolderRatingFilterToggle" Content="Rating"
                                          Padding="6,3" Margin="6,0,0,0"
                                          ToolTip="Filter folders by rating"/>
                        </StackPanel>
                        <Popup x:Name="TagsFilterPopup" PlacementTarget="{Binding ElementName=TagsFilterToggle}"
                               Placement="Bottom" StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=TagsFilterToggle, Mode=TwoWay}"
                               Opened="TagsFilterPopup_Opened">
                            <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" Padding="6"
                                    MinWidth="150" MaxHeight="240">
                                <StackPanel>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="TagsFilterItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Margin="2" Click="TagFilterCheckBox_Click"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Separator Margin="0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Clear" Click="TagsFilterClear_Click" Padding="6,2"/>
                                        <Button Content="Manage tags..." Click="ManageTags_Click"
                                                Margin="8,0,0,0" Padding="6,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup PlacementTarget="{Binding ElementName=FolderRatingFilterToggle}"
                               Placement="Bottom" StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=FolderRatingFilterToggle, Mode=TwoWay}">
                            <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" Padding="6" MinWidth="120">
                                <StackPanel>
                                    <StackPanel x:Name="FolderRatingFilterPanel">
                                        <CheckBox Content="Any rating" Margin="2" Tag="0" Click="FolderRatingFilterCheckBox_Click"/>
                                        <CheckBox Content="&#9733; 1" Margin="2" Tag="1" Click="FolderRatingFilterCheckBox_Click"/>
                                        <CheckBox Content="&#9733; 2" Margin="2" Tag="2" Click="FolderRatingFilterCheckBox_Click"/>
                                        <CheckBox Content="&#9733; 3" Margin="2" Tag="3" Click="FolderRatingFilterCheckBox_Click"/>
                                        <CheckBox Content="&#9733; 4" Margin="2" Tag="4" Click="FolderRatingFilterCheckBox_Click"/>
                                        <CheckBox Content="&#9733; 5" Margin="2" Tag="5" Click="FolderRatingFilterCheckBox_Click"/>
                                    </StackPanel>
                                    <Separator Margin="0,4"/>
                                    <Button Content="Clear" Click="FolderRatingFilterClear_Click" Padding="6,2" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </TabItem>

        <!-- Playlists Tab -->
        <TabItem Header="Playlists">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="+ New Playlist" Margin="5" Padding="4"
                        Click="NewPlaylist_Click"/>

                <ListBox x:Name="PlaylistListBox" Grid.Row="1"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                         SelectionChanged="PlaylistListBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="PlaylistItem_PreviewMouseRightButtonDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding TrackCount}"
                                           VerticalAlignment="Center"
                                           Foreground="#999999" FontSize="11" Margin="6,0,2,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Rename" Click="PlaylistRename_Click"/>
                            <MenuItem Header="Delete" Click="PlaylistDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </TabItem>
        </TabControl>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="LightGray"/>

        <!-- Right Panel: Music Grid + Player -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Recent Played Folders -->
            <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                    Visibility="{Binding RecentPlayedFolders.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="4">
                    <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding RecentPlayedFolders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1"
                                        CornerRadius="3" Margin="2" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Cursor="Hand"
                                                   Foreground="#1565C0"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding FullPath}"
                                                   MouseLeftButtonUp="RecentFolder_Click"
                                                   ToolTip="{Binding FullPath}"/>
                                        <Button Content="&#10005;"
                                                Width="16" Height="16"
                                                FontSize="9"
                                                Padding="0"
                                                Margin="6,0,0,0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Foreground="#777777"
                                                Cursor="Hand"
                                                Tag="{Binding FullPath}"
                                                Click="RemoveRecentFolder_Click"
                                                ToolTip="Remove from list"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="&#10005;"
                            Width="20" Height="20"
                            FontSize="10"
                            Padding="0"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="#777777"
                            Cursor="Hand"
                            Click="ClearRecentFolders_Click"
                            ToolTip="Clear all recent folders"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Files filter bar: text search + star-rating multi-select (any/specific, OR'd) -->
            <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <TextBox x:Name="FileFilterBox"
                                 Text="{Binding FileFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter files by name, title, artist or album"
                                 Padding="4,2,20,2"/>
                        <Button Content="&#x2715;" Click="ClearFileFilter_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="18" Height="18" Margin="0,0,3,0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#888888" FontSize="11" Cursor="Hand"
                                ToolTip="Clear filter">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FileFilterText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <ToggleButton Grid.Column="1" x:Name="FileRatingFilterToggle" Content="Rating"
                                  Padding="6,3" VerticalAlignment="Center"
                                  ToolTip="Filter files by rating"/>
                    <Popup PlacementTarget="{Binding ElementName=FileRatingFilterToggle}"
                           Placement="Bottom" StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=FileRatingFilterToggle, Mode=TwoWay}">
                        <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1" Padding="6" MinWidth="120">
                            <StackPanel>
                                <StackPanel x:Name="FileRatingFilterPanel">
                                    <CheckBox Content="Any rating" Margin="2" Tag="0" Click="FileRatingFilterCheckBox_Click"/>
                                    <CheckBox Content="&#9733; 1" Margin="2" Tag="1" Click="FileRatingFilterCheckBox_Click"/>
                                    <CheckBox Content="&#9733; 2" Margin="2" Tag="2" Click="FileRatingFilterCheckBox_Click"/>
                                    <CheckBox Content="&#9733; 3" Margin="2" Tag="3" Click="FileRatingFilterCheckBox_Click"/>
                                    <CheckBox Content="&#9733; 4" Margin="2" Tag="4" Click="FileRatingFilterCheckBox_Click"/>
                                    <CheckBox Content="&#9733; 5" Margin="2" Tag="5" Click="FileRatingFilterCheckBox_Click"/>
                                </StackPanel>
                                <Separator Margin="0,4"/>
                                <Button Content="Clear" Click="FileRatingFilterClear_Click" Padding="6,2" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Music Files Grid (with album cover behind) -->
            <Grid Grid.Row="2" x:Name="CoverHost" SizeChanged="CoverHost_SizeChanged"
                  MouseLeftButtonUp="CoverHost_MouseLeftButtonUp">
            <!-- Album Cover (behind the file list) -->
            <!-- Holds the outgoing cover so art changes crossfade instead of popping. -->
            <Image x:Name="AlbumCoverGhost"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   MaxWidth="450" MaxHeight="450"
                   Margin="40,0,40,0"
                   Opacity="0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="AlbumCoverGhostOffset"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="AlbumCoverImage"
                   Source="{Binding AlbumCover, NotifyOnTargetUpdated=True}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   MaxWidth="450" MaxHeight="450"
                   Margin="40,0,40,0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SizeChanged="AlbumCoverImage_SizeChanged"
                   TargetUpdated="AlbumCoverImage_TargetUpdated">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="AlbumCoverImageOffset"/>
                </Image.RenderTransform>
            </Image>

            <DataGrid x:Name="MusicFilesGrid"
                      Background="Transparent"
                      ItemsSource="{Binding MusicFilesView}"
                      SelectedItem="{Binding SelectedFile}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="None"
                      AlternationCount="2"
                      RowHeight="22"
                      PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                      MouseMove="MusicFilesGrid_MouseMove"
                      MouseDoubleClick="MusicFilesGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource NowPlayingConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.NowPlaying" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#BEF0F0F0"/>
                            </Trigger>
                            <!-- Kept alongside the CellStyle trigger below (belt-and-suspenders) —
                                 DataGridRow.Background sits behind the cells and doesn't reliably
                                 paint over them, which is what the CellStyle trigger is for; this one
                                 still drives the left accent bar via the row's own border. -->
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource NowPlayingBoolConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.NowPlaying" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#90CAF9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <!-- Paints the now-playing highlight ON the cells too (not just the row, which
                     sits behind DataGridCellsPresenter and doesn't reliably render its Background
                     over them) — this is what actually makes the highlight visible against the
                     transparent grid/album-cover background. Transparent otherwise so non-playing
                     rows still show the album art through the grid. -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <!-- Foreground/BorderBrush must be set here, not left to the theme. This style
                             REPLACES the theme's DataGridCell style setters but the theme's *triggers*
                             still apply to any property this style leaves alone (explicit-style setters
                             outrank theme-style triggers, theme triggers outrank nothing at all). The
                             theme's IsSelected trigger paints Foreground white + BorderBrush highlight-blue,
                             on the assumption its Background trigger painted the cell blue too — but the
                             Transparent setter above suppresses exactly that. Result was white text on a
                             white row inside blue cell outlines: the selected row looked like a strip of
                             empty boxes, with a black outline on the focused cell (the theme's
                             IsKeyboardFocusWithin trigger). -->
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <!-- Three row states, painted here on the CELLS (the row's own Background sits
                             behind them). Trigger order IS the priority — later wins:
                               hover  #EBF4FE  faint wash, follows the mouse
                               select #CCE8FF  Explorer blue, independent of focus so it never dims
                               play   #90CAF9  + SemiBold + left accent bar, outranks the other two so
                                               the "what's playing" marker never flickers under the mouse -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter Property="Background" Value="#EBF4FE"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCE8FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource NowPlayingBoolConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.NowPlaying" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="#90CAF9"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationFormatted}" Width="70"/>
                    <DataGridTextColumn Header="Bitrate" Binding="{Binding BitrateFormatted}" Width="80"/>
                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="80"/>
                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="50"/>
                    <DataGridTemplateColumn Header="" Width="24" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="&#x1F3A4;" FontSize="11" Foreground="#AAAAAA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           ToolTip="Has lyrics"
                                           Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- The next two columns reveal editors on row hover, and both are TALLER than
                         what they replace: an unrated StarRating collapses all five stars (zero height)
                         until hover, and the tags TextBox outgrows its TextBlock. Without the grid's
                         pinned RowHeight above, every hover re-measured the row and the list nudged
                         itself a few pixels under the cursor. Keep new cell content within 22px. -->
                    <DataGridTemplateColumn Header="Rating" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:StarRating Rating="{Binding Rating, Mode=TwoWay}"
                                                     EditMode="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tags" Width="160" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Tags}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="#777777">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             BorderThickness="0" Background="Transparent"
                                             Padding="0" VerticalAlignment="Center"
                                             ToolTip="Comma-separated tags">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="FileContextMenu" Opened="FileContextMenu_Opened"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Copy filename" Tag="name" Click="FileCopyText_Click"/>
                        <MenuItem Header="Copy path" Tag="dir" Click="FileCopyText_Click"/>
                        <MenuItem Header="Copy full path" Tag="full" Click="FileCopyText_Click"/>
                        <Separator/>
                        <MenuItem x:Name="FileCopyToMenu" Header="Copy To"/>
                        <MenuItem x:Name="FileMoveToMenu" Header="Move To"/>
                        <Separator/>
                        <MenuItem x:Name="FileAddToPlaylistMenu" Header="Add to Playlist"/>
                        <MenuItem Header="New Playlist from Selection" Click="NewPlaylistFromSelection_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove from Playlist" Click="RemoveFromPlaylist_Click"
                                  IsEnabled="{Binding IsPlaylistView}"/>
                        <MenuItem Header="Move Up" Click="MoveEntryUp_Click"
                                  IsEnabled="{Binding IsPlaylistView}"/>
                        <MenuItem Header="Move Down" Click="MoveEntryDown_Click"
                                  IsEnabled="{Binding IsPlaylistView}"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="FileDelete_Click"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="FileProperties_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- Loading overlay -->
            <Border Background="#80FFFFFF" IsHitTestVisible="False"
                    Visibility="{Binding IsLoadingFiles, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="6"/>
                    <TextBlock Text="Loading files…" HorizontalAlignment="Center"
                               Margin="0,8,0,0" Foreground="#555555"/>
                </StackPanel>
            </Border>
            </Grid>

            <!-- Karaoke Lyrics Panel -->
            <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                    Padding="10,6"
                    Visibility="{Binding ShowLyrics, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="MaxHeight" Value="220"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding KaraokeMode}" Value="True">
                                <Setter Property="MaxHeight" Value="340"/>
                            </DataTrigger>
                            <!-- Time-proportional row spacing needs extra room while sync-editing. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLyricsEditMode}" Value="True"/>
                                    <Condition Binding="{Binding HasSyncedLyrics}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="MaxHeight" Value="340"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: now-playing title/status + Find / Sync / Karaoke / Edit / close.
                         No Save/Cancel — lyrics auto-save (~500ms debounce, see
                         MainViewModel.ScheduleLyricsAutoSave); "Edit" toggles to "Done". -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding NowPlaying.FileName, FallbackValue=Lyrics}"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text="{Binding LyricsStatus}" FontSize="11" Foreground="#888888"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Find" FontSize="11" Padding="8,2" Margin="3,0"
                                    Command="{Binding FindLyricsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLyricsEditMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Sync" FontSize="11" Padding="8,2" Margin="3,0"
                                    Command="{Binding SyncLyricsWhisperCommand}"
                                    Visibility="{Binding CanSyncLyrics, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Karaoke" FontSize="11" Padding="8,2" Margin="3,0"
                                    Command="{Binding ToggleKaraokeModeCommand}" ToolTip="Big-letter karaoke view">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KaraokeMode}" Value="True">
                                                <Setter Property="Background" Value="#90CAF9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Auto-scroll follow toggle: highlighted while the row list is actively
                                 following the playhead, de-highlighted while frozen (row selected/
                                 hovered/just manually scrolled — see MainWindow.xaml.cs
                                 IsLyricsAutoScrollSuspended). Clicking clears the selection and
                                 resumes following immediately — the discoverable way back, since a
                                 selection freeze has no timeout. Only relevant for the row list, so
                                 hidden in Karaoke view or when there's no timing to follow. -->
                            <Button Content="Follow" FontSize="11" Padding="8,2" Margin="3,0"
                                    Click="FollowLyricsButton_Click" ToolTip="Follow the playhead (auto-scroll)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#90CAF9"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasSyncedLyrics}" Value="True"/>
                                                    <Condition Binding="{Binding KaraokeMode}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding LyricsFollowing}" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Wipes the cached lyrics (DB row + in-memory) and drops into the empty
                                 raw-paste box — the only way to replace a whole synced/bad result
                                 (e.g. an old copyright-refusal saved before the AI-refusal fix), since
                                 Edit on a synced track shows inline rows, not a paste box, and Find is
                                 hidden in edit mode. Visible in both view and edit mode — unlike Find —
                                 so it's always reachable to reset. CanSyncLyrics already tracks
                                 "lyric lines loaded" regardless of synced state, so it's reused as-is
                                 rather than adding a duplicate bool. -->
                            <Button Content="Clear" FontSize="11" Padding="8,2" Margin="3,0"
                                    Command="{Binding ClearLyricsCommand}"
                                    Visibility="{Binding CanSyncLyrics, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Clear cached lyrics and start over"/>
                            <Button FontSize="11" Padding="8,2" Margin="3,0"
                                    Command="{Binding EditLyricsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Edit"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLyricsEditMode}" Value="True">
                                                <Setter Property="Content" Value="Done"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="&#10005;" FontSize="11" Padding="6,2" Margin="8,0,0,0"
                                    Command="{Binding ToggleLyricsCommand}" ToolTip="Hide lyrics"
                                    Background="Transparent" BorderThickness="0" Foreground="#888888" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- View/edit mode: scrolling line list, active line highlighted, per-line timing
                         controls. Stays visible while editing a SYNCED track (HasSyncedLyrics) — the
                         row's text becomes an inline editable TextBox instead of collapsing the whole
                         list for the raw textbox below, so editing words never loses timestamps. Only
                         collapses for edit mode on plain/unsynced lyrics (the raw textbox owns that case). -->
                    <ListBox x:Name="LyricsListBox" Grid.Row="1"
                             ItemsSource="{Binding LyricsLines}"
                             Focusable="False"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.ScrollChanged="LyricsListBox_ScrollChanged"
                             SelectionChanged="LyricsListBox_SelectionChanged"
                             KeyDown="LyricsListBox_KeyDown"
                             ButtonBase.Click="LyricsRowButton_Click">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Margin" Value="0"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLyricsEditMode}" Value="True"/>
                                            <Condition Binding="{Binding HasSyncedLyrics}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding KaraokeMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Top spacer sized by GapPx (MainViewModel.RecomputeLyricRowGaps) makes the
                                     list read as a time-proportional layout — sparse where lines are far
                                     apart, tight where they come fast — instead of an even stack. Zero for
                                     plain/unsynced lyrics, so those still stack normally. -->
                                <StackPanel Orientation="Vertical">
                                    <Border Height="{Binding GapPx}"/>
                                    <!-- Highlight band behind the active row (view AND edit mode, since this
                                         row list stays visible in both for synced tracks). Wraps only the
                                         content Grid below — the spacer Border above stays transparent. -->
                                    <Border CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#DCEBFB"/>
                                                        <Setter Property="Padding" Value="4,1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeFormatted}"
                                               FontFamily="Consolas" FontSize="10" Foreground="#AAAAAA"
                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    <!-- Read-only text (normal view) vs. inline editable text (Edit mode on a
                                         synced track — this row list stays visible instead of the raw
                                         textbox, see LyricsListBox.Style above). Both bind DataContext
                                         through the ListBox since IsLyricsEditMode lives on the VM, not
                                         this row's own LyricLine DataContext. -->
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="#777777" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLyricsEditMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="FontSize" Value="15"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" TextWrapping="Wrap"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLyricsEditMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                    <!-- Hand-timing controls: "now" stamps the current playback position,
                                         −/+ nudge by 0.2s. Work on plain (Time=0) lines too, not just
                                         already-synced ones — that's how a failed/skipped auto-sync gets
                                         hand-timed (see MainViewModel.RunWhisperSyncAsync). -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#8722;" FontSize="10" Padding="4,0" Margin="2,0"
                                                Command="{Binding DataContext.NudgeLyricLineBackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="-0.2s"/>
                                        <Button Content="&#9210;" FontSize="10" Padding="4,0" Margin="2,0"
                                                Command="{Binding DataContext.SetLyricLineNowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="Set to current playback position"/>
                                        <Button Content="+" FontSize="10" Padding="4,0" Margin="2,0"
                                                Command="{Binding DataContext.NudgeLyricLineForwardCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" ToolTip="+0.2s"/>
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- "Now" playhead: a thin accent line marking the current time's position in the
                         time-proportional row list. Positioned via a TranslateTransform in code-behind
                         (MainWindow.xaml.cs UpdateLyricsPlayhead), matching the album-cover positioning
                         idiom elsewhere in this file — not a Margin, which would participate in layout.
                         Computed from the ScrollViewer's real VerticalOffset (not just pinned to the
                         viewport centre), so it stays correct whether auto-scroll, a manual scroll, or a
                         paused track left the list where it is. Visibility/position both driven entirely
                         from code-behind since they depend on live scroll geometry, not a bindable VM
                         property. -->
                    <Border x:Name="LyricsPlayheadLine" Grid.Row="1" Height="2" Background="#1565C0"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LyricsPlayheadTransform"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Edit mode on PLAIN/unsynced lyrics only — there's no timing to lose, so a raw
                         multiline textbox is the right tool. Synced tracks edit inline in the row
                         list above instead (LyricsListBox stays visible; see its Style). -->
                    <TextBox Grid.Row="1"
                             Text="{Binding LyricsEditText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLyricsEditMode}" Value="True"/>
                                            <Condition Binding="{Binding HasSyncedLyrics}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Karaoke big view: EVERY line renders in a stable ItemsControl (KaraokeWindow,
                         one KaraokeWindowLine per LyricsLines entry, built once per track); the
                         current line is kept centered by animating a TranslateTransform on the
                         ItemsControl (see MainWindow.xaml.cs PanKaraokeToCurrentLine), which glides
                         the whole song smoothly rather than popping between line swaps. ClipToBounds
                         + OpacityMask on the VIEWPORT (not the transformed ItemsControl itself — an
                         OpacityMask on a transformed element is measured pre-transform, in the
                         element's own oversized bounds, and wouldn't line up with what's actually
                         visible) crop it down to a window with faded top/bottom edges. Separate from
                         the list/edit views. -->
                    <Grid Grid.Row="1" x:Name="KaraokeViewport" ClipToBounds="True">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLyricsEditMode}" Value="False"/>
                                            <Condition Binding="{Binding KaraokeMode}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#FF000000" Offset="0.15"/>
                                <GradientStop Color="#FF000000" Offset="0.85"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Grid.OpacityMask>

                        <TextBlock Text="Sync lyrics to use Karaoke mode — tap Find or Sync above."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#999999" FontSize="12" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="260">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSyncedLyrics}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Falloff by |Offset| (clamped in the VM) = dimmer + smaller; IsCurrent is
                             the big/bright line the pan keeps centered. -->
                        <ItemsControl x:Name="KaraokeItemsControl" ItemsSource="{Binding KaraokeWindow}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ItemsControl.RenderTransform>
                                <TranslateTransform x:Name="KaraokePanTransform"/>
                            </ItemsControl.RenderTransform>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSyncedLyrics}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="15"/>
                                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <!-- Baseline for a non-current line at Offset=0 too — the anchor-at-song-start
                                                     case (no active line yet) matches no numbered trigger below. -->
                                                <Setter Property="Opacity" Value="0.9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Offset}" Value="-1">
                                                        <Setter Property="FontSize" Value="18"/>
                                                        <Setter Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Offset}" Value="1">
                                                        <Setter Property="FontSize" Value="18"/>
                                                        <Setter Property="Opacity" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Offset}" Value="-2">
                                                        <Setter Property="FontSize" Value="15"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Offset}" Value="2">
                                                        <Setter Property="FontSize" Value="15"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Offset}" Value="-3">
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Offset}" Value="3">
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="FontSize" Value="32"/>
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="Margin" Value="0,10"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Audio Player Control -->
            <Border Grid.Row="4" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10"
                    MouseWheel="PlayerPanel_MouseWheel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Player Controls (70%) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Now Playing Info + current-file actions. Rating/tags bind straight at
                             NowPlaying (a MusicFile instance out of MusicFiles), so MainViewModel's
                             File_PropertyChanged hook persists edits here exactly like the grid's. -->
                        <Grid Grid.Row="0" Margin="0,0,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding NowPlaying.FileName, FallbackValue='No file playing'}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        IsEnabled="{Binding NowPlaying, Converter={StaticResource NullToBoolConverter}}">
                                <controls:StarRating Rating="{Binding NowPlaying.Rating, Mode=TwoWay}" EditMode="True"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="160" Height="20" VerticalContentAlignment="Center"
                                         Text="{Binding NowPlaying.Tags, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Comma-separated tags" Margin="0,0,8,0"/>
                                <Button Content="Copy" Padding="8,1" Margin="0,0,4,0"
                                        Click="NowPlayingCopy_Click" ToolTip="Copy the playing file"/>
                                <Button Content="Move" Padding="8,1" Margin="0,0,4,0"
                                        Click="NowPlayingMove_Click" ToolTip="Move the playing file"/>
                                <Button Content="Delete" Padding="8,1"
                                        Click="NowPlayingDelete_Click" ToolTip="Delete the playing file"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Slider -->
                        <Grid Grid.Row="1" Margin="0,5,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CurrentPositionFormatted}" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1"
                                    x:Name="ProgressBar"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding SliderValue, Mode=OneWay}"
                                    Margin="10,0"
                                    Height="20"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalDurationFormatted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Control Buttons and Volume -->
                        <Grid Grid.Row="2" Margin="0,10,10,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- ponytail: Auto, not *, or the star share starves this column and the
                                     device/buffer boxes overflow left and get clipped by the transport buttons. -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle" Content="&#x1F500;">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShuffleEnabled}" Value="True">
                                                    <Setter Property="Background" Value="#90CAF9"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="&#9664;&#9664;" Style="{StaticResource PlayerButtonStyle}"
                                        Command="{Binding PreviousCommand}" ToolTip="Previous"/>
                                <Button Style="{StaticResource PlayerPlayButtonStyle}"
                                        Command="{Binding PlayPauseCommand}" ToolTip="Play/Pause">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#9654;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Text" Value="&#10074;&#10074;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="&#9632;" Style="{StaticResource PlayerButtonStyle}"
                                        Command="{Binding StopCommand}" ToolTip="Stop"/>
                                <Button Content="&#9654;&#9654;" Style="{StaticResource PlayerButtonStyle}"
                                        Command="{Binding NextCommand}" ToolTip="Next"/>
                                <Button Command="{Binding CycleRepeatCommand}" ToolTip="Repeat"
                                        Content="{Binding RepeatGlyph}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RepeatActive}" Value="True">
                                                    <Setter Property="Background" Value="#90CAF9"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding StartKaraokeCommand}" ToolTip="Karaoke" Content="&#x1F3A4;">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KaraokeMode}" Value="True">
                                                    <Setter Property="Background" Value="#90CAF9"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Remote playback indicator + kill switch (click to take audio back to this PC) -->
                            <Button Grid.Column="1" Command="{Binding ExitRemoteSinkCommand}"
                                    Margin="10,0" VerticalAlignment="Center" Cursor="Hand"
                                    ToolTip="Playing on phone — click to bring audio back to this PC"
                                    Visibility="{Binding RemoteSink, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1E88E5" CornerRadius="4" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F4F1; Remote playback" Foreground="White"
                                                           FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="&#x2715;" Foreground="White" FontWeight="Bold"
                                                           FontSize="12" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Output Device + Volume Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- WASAPI buffer size -->
                                <ComboBox Width="82" Height="22"
                                          VerticalAlignment="Center" Margin="0,0,4,0"
                                          ItemsSource="{Binding BufferOptions}"
                                          SelectedItem="{Binding OutputBufferMs, Mode=TwoWay}"
                                          ItemStringFormat="{}{0} ms"
                                          ToolTip="Audio buffer — higher survives high CPU load, lower gives snappier volume/seek response"/>
                                <!-- Output device selector -->
                                <ComboBox x:Name="OutputDeviceBox"
                                          Width="190" Height="22"
                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                          ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          DropDownOpened="OutputDeviceBox_DropDownOpened"
                                          ToolTip="Output device"/>
                                <!-- System (Windows master) volume -->
                                <TextBlock Text="&#x1F310;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ProgressBar x:Name="SystemVolumeBar"
                                             Width="80" Height="20"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding SystemVolume, Mode=OneWay}"
                                             Cursor="Hand"
                                             ToolTip="System volume (whole PC)"
                                             Margin="0,0,15,0"
                                             MouseLeftButtonDown="SystemVolumeBar_MouseLeftButtonDown"
                                             MouseMove="SystemVolumeBar_MouseMove"
                                             MouseLeftButtonUp="SystemVolumeBar_MouseLeftButtonUp"/>
                                <!-- In-app volume -->
                                <TextBlock Text="&#128266;" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ProgressBar x:Name="VolumeBar"
                                             Width="80" Height="20"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Volume, Mode=OneWay}"
                                             Cursor="Hand"
                                             ToolTip="App volume"
                                             MouseLeftButtonDown="VolumeBar_MouseLeftButtonDown"
                                             MouseMove="VolumeBar_MouseMove"
                                             MouseLeftButtonUp="VolumeBar_MouseLeftButtonUp"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Right: AI Artist Summary (30%) -->
                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding ArtistSummary, FallbackValue='Select a track to see artist info'}"
                                       FontSize="11"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                            <Button Grid.Column="1" Content="&#8635;" FontSize="14" Padding="5,2"
                                    Command="{Binding RefreshArtistInfoCommand}"
                                    ToolTip="Load artist info"
                                    VerticalAlignment="Top"
                                    IsEnabled="{Binding NowPlaying, Converter={StaticResource NullToBoolConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Album cover zoom overlay: click cover to enlarge, click anywhere to dismiss -->
        <Border x:Name="CoverZoomOverlay" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#E6101010" Visibility="Collapsed" Cursor="Hand"
                MouseLeftButtonUp="CoverZoomOverlay_MouseLeftButtonUp">
            <Image Source="{Binding AlbumCover}" Stretch="Uniform" Margin="20"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- Busy overlay: shown during long tree operations (sort change, folder restore) -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="#66000000"
                Visibility="{Binding FolderTree.IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="#F7FFFFFF" CornerRadius="8" Padding="26,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#CCCCCC" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="190" Height="6"/>
                    <TextBlock Text="Working&#8230;" Margin="0,10,0,0" HorizontalAlignment="Center"
                               FontSize="12" Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
