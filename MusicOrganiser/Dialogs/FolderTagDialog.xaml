<Window x:Class="MusicOrganiser.Dialogs.FolderTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag folder"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Foreground="Gray"
                   Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TagsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="NewTagBox" Width="220" KeyDown="NewTagBox_KeyDown"/>
            <Button Content="Add" Width="60" Margin="8,0,0,0" Click="AddTag_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="75" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="OK" Width="75" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
