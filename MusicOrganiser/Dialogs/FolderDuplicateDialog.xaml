<Window x:Class="MusicOrganiser.Dialogs.FolderDuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Already Exists"
        Height="640" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="450" MinWidth="750"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="70"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#777777"/>
        </Style>

        <!-- Source-side name cell: text, or a TextBox while renaming (F2 / double-click) -->
        <DataTemplate x:Key="SourceNameCell">
            <Grid Margin="{Binding Indent}">
                <TextBlock x:Name="Txt" Text="{Binding SourceName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MouseLeftButtonDown="SourceName_MouseDown"/>
                <TextBox x:Name="Box" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                         VerticalContentAlignment="Center" IsVisibleChanged="EditBox_IsVisibleChanged"
                         PreviewKeyDown="EditBox_PreviewKeyDown" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EditingSide}" Value="1">
                    <Setter TargetName="Txt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Box" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TargetNameCell">
            <Grid Margin="{Binding Indent}">
                <TextBlock x:Name="Txt" Text="{Binding TargetName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MouseLeftButtonDown="TargetName_MouseDown"/>
                <TextBox x:Name="Box" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                         VerticalContentAlignment="Center" IsVisibleChanged="EditBox_IsVisibleChanged"
                         PreviewKeyDown="EditBox_PreviewKeyDown" LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding EditingSide}" Value="2">
                    <Setter TargetName="Txt" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Box" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="&#9888;" FontSize="24" Foreground="#D4A017" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="The same or a similar folder already exists in the destination."
                       FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Source | Existing folder info -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Source Folder" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2" Height="22">
                        <TextBlock Text="Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="SourceFolderName" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Files:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="SourceFileCount" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Total Size:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="SourceTotalSize" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="&#10132;" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Existing Folder" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2" Height="22">
                        <TextBlock Text="Name:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TargetCombo" MinWidth="180" SelectionChanged="TargetCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Files:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TargetFileCount" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Total Size:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TargetTotalSize" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Presets + live summary -->
        <DockPanel Grid.Row="2" Margin="0,10,0,6" LastChildFill="True">
            <Button x:Name="ReplacePresetButton" DockPanel.Dock="Right" Content="Replace" Width="80" Height="26"
                    ToolTip="New and different files are transferred, target-only files are deleted" Click="ReplacePreset_Click"/>
            <Button x:Name="MergePresetButton" DockPanel.Dock="Right" Content="Merge" Width="80" Height="26" Margin="0,0,8,0"
                    ToolTip="Only new files are transferred, nothing is overwritten or deleted" Click="MergePreset_Click"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444444"/>
        </DockPanel>

        <!-- Aligned comparison: source | action | target -->
        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1">
            <DataGrid x:Name="PlanGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeight="26"
                      BorderThickness="0"
                      PreviewKeyDown="PlanGrid_PreviewKeyDown">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CategoryName}" Value="New">
                                <Setter Property="Background" Value="#EAF6EA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CategoryName}" Value="Different">
                                <Setter Property="Background" Value="#FFF1E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CategoryName}" Value="TargetOnly">
                                <Setter Property="Foreground" Value="#888888"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Source" Width="*" MinWidth="140" CellTemplate="{StaticResource SourceNameCell}"/>
                    <DataGridTemplateColumn Header="Size" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceSize}" Style="{StaticResource CellText}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Length" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SourceDuration}" Style="{StaticResource CellText}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Action" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Glyph}" ToolTip="{Binding Tooltip}" Visibility="{Binding ActionVisibility}"
                                        Width="34" Height="22" FontSize="14" Padding="0" Click="ActionButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Existing" Width="*" MinWidth="140" CellTemplate="{StaticResource TargetNameCell}"/>
                    <DataGridTemplateColumn Header="Size" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TargetSize}" Style="{StaticResource CellText}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Length" Width="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TargetDuration}" Style="{StaticResource CellText}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Hidden-folders note + loading bar -->
        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <TextBlock x:Name="HiddenNote" FontSize="11" Foreground="#888888" Visibility="Collapsed"/>
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed">
                <TextBlock Text="Comparing..." FontSize="11" Foreground="#555555" Margin="0,0,0,3"/>
                <ProgressBar IsIndeterminate="True" Height="6"/>
            </StackPanel>
        </StackPanel>

        <!-- Legend -->
        <Border Grid.Row="5" Background="#F5F5F5" Padding="10" Margin="0,10,0,0">
            <TextBlock x:Name="LegendText" TextWrapping="Wrap" FontSize="11" Foreground="#555555"/>
        </Border>

        <!-- New name (Keep both) -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Name (new folder / subfolder):" Style="{StaticResource LabelStyle}" Width="190" VerticalAlignment="Center"/>
            <TextBox x:Name="NewNameBox" Width="300" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="ExecuteButton" Width="80" Height="28" Margin="0,0,10,0" Click="ExecuteButton_Click"/>
            <Button x:Name="IntoTargetButton" MinWidth="80" Height="28" Padding="10,0" Margin="0,0,10,0" Click="IntoTargetButton_Click"/>
            <Button x:Name="KeepBothButton" MinWidth="80" Height="28" Padding="10,0" Margin="0,0,10,0" Click="KeepBothButton_Click"/>
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
